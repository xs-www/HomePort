{
  "name": "homeport",
  "version": "0.1.0",
  "private": true,
  "description": "HomePort（母港）· Tailnet 动态门户控制面板：容器入口、设备状态、系统指标、工具聚合与登录权限管理",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "build:web": "npm run build --workspace web",
    "build:server": "npm run build --workspace server",
    "start": "node server/dist/index.js",
    "test": "npm run test --workspace server && npm run test --workspace web",
    "test:server": "npm run test --workspace server",
    "test:web": "npm run test --workspace web",
    "test:e2e": "playwright test",
    "e2e:serve": "node e2e/start-server.mjs",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=120"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
