# ==============================================================================
# HomePort（母港）门户 — 环境变量样例
#
#   cp .env.example .env      然后按你的平台取消对应注释
#
# 全部变量都有合理默认值，**最小可用配置是空文件**。
# ==============================================================================

# ------------------------------------------------------------------ 门户自身

# 门户对外监听的宿主端口
PORTAL_HOST_PORT=8899

# 端口绑定地址。0.0.0.0 = tailnet 与局域网都可访问；
# 只想经 tailnet 访问时填宿主 tailnet IP（如 100.72.255.29）
PORTAL_BIND_ADDR=0.0.0.0

# 日志级别：debug | info | warn | error
PORTAL_LOG_LEVEL=info

# 门户对外的公开主机名（MagicDNS 名或 tailnet IP），用于生成容器/工具的入口链接。
# 留空时按访问者的请求头自动推导，通常无需设置。
# PORTAL_PUBLIC_HOST=sisi-laptop.tail921448.ts.net

# 部署在 HTTPS 反向代理之后时设为 1（会话 Cookie 会带 Secure 属性）
# PORTAL_SECURE_COOKIES=1

# 首启初始化令牌。留空则自动生成，写入 /data/setup-token.txt 并打印到容器日志。
# 便于自动化部署时可显式指定。
# PORTAL_SETUP_TOKEN=

# 时区（影响日志时间戳与界面时间）
TZ=Asia/Shanghai

# 会话有效期（小时）与「记住我」有效期（小时）
PORTAL_SESSION_TTL_HOURS=12
PORTAL_SESSION_REMEMBER_TTL_HOURS=720

# 指标推送间隔（毫秒）
PORTAL_METRICS_INTERVAL_MS=3000

# ------------------------------------------------------------------ 安全（Sprint 0）

# 安全响应头总开关（0 关闭）。默认开：
#   X-Content-Type-Options / X-Frame-Options / Referrer-Policy / COOP / CORP /
#   Permissions-Policy / Content-Security-Policy，且 /api/* 一律 cache-control: no-store
PORTAL_SECURITY_HEADERS=1

# 自定义 CSP。留空即用内置默认策略（推荐）。
# 只有在你需要嵌入外部资源（比如自建 CDN）时才覆盖，覆盖后请回头看 06-security.md。
# PORTAL_CSP=default-src 'self'; img-src 'self' data: https://cdn.example.com

# HSTS。**只在 HTTPS 下才下发**（门户自己判断，直连 HTTP 时自动忽略），
# 且默认不带 includeSubDomains（避免污染 *.ts.net 下的其它服务）。
PORTAL_HSTS=1
PORTAL_HSTS_MAX_AGE=15552000

# 反代信任边界。默认 loopback：只信任来自本机反代（tailscale serve）的转发头，
# 因此限流能拿到真实客户端 IP，同时伪造的 X-Forwarded-For 会被忽略。
#   0        = 完全不信任任何转发头（门户被直接暴露、前面没有反代时用这个）
#   loopback = 只信任 127.0.0.1 / ::1 来的转发头（**推荐，默认**）
#   <IP/CIDR 列表，逗号分隔>  = 信任这些反代来源（自建 nginx/Caddy 时用）
#   1 / true = 信任所有来源（**危险**：任何人都能伪造 IP 绕过登录限流）
PORTAL_TRUST_PROXY=loopback

# 敏感数据加密主密钥（AES-256-GCM，用于设置项里的敏感值 + TOTP 种子）。
# **留空即可**：门户会自动生成 <数据目录>/secret.key（权限 0600）并复用。
# 只有"密钥不落盘、由外部注入"的部署才需要显式设置（值需为 32 字节的 base64）。
# ⚠ 丢了这把钥匙，已加密的敏感设置与 TOTP 种子都无法恢复（用户可重新绑定 TOTP）。
# PORTAL_SECRET_KEY=
# 密钥文件路径（默认 <数据目录>/secret.key）。容器里一般不用设置。
# PORTAL_SECRET_KEY_FILE=
# 轮换：旧密钥填这里（逗号分隔，可多个），改主密钥后旧数据仍能读出，
# 门户启动时会自动把旧密文升级为新密钥。
# PORTAL_SECRET_KEY_PREVIOUS=

# ------------------------------------------------------------------ 两步验证（TOTP，Sprint 0）

# 是否允许用户绑定两步验证。默认开。
# 关闭只是"不允许新绑定"：**已经绑定的账号仍会继续要求第二步**（避免静默降低安全性）。
PORTAL_TOTP_ENABLED=1

# 验证器 App 里显示的发行方名称
PORTAL_TOTP_ISSUER=HomePort

# 时间窗容差（±N 个 30 秒周期）。默认 1，即容忍前后各 30 秒的设备时钟偏差。
# 手机时间不准时不要靠调大这个值解决（会削弱防重放），请先校准时间。
PORTAL_TOTP_WINDOW=1

# 登录第二步的挑战有效期（秒）。默认 300（5 分钟）。
PORTAL_TOTP_CHALLENGE_TTL_SECONDS=300

# ------------------------------------------------------------------ 部署矩阵
#
# 下面按平台给出推荐值。**注意：compose 会读取 .env**，所以直接取消注释即可。

# ============================ Windows 11 + Docker Desktop ============================
#
# ⚠ 关键：容器化部署时 DOCKER_ENDPOINT **必须**是 unix socket，不要写 npipe！
#   Docker Desktop 会把 Windows 的 named pipe 转发成容器内的 /var/run/docker.sock，
#   在容器里用 npipe:// 会报 ENOENT。
#   下面这行保持默认即可（compose 里已默认 unix）：
# DOCKER_ENDPOINT=unix:///var/run/docker.sock
# DOCKER_SOCKET=//var/run/docker.sock
#
# npipe 写法仅用于「在 Windows 上原生运行 Node」的开发/调试场景：
# DOCKER_ENDPOINT=npipe:////./pipe/dockerDesktopLinuxEngine
#
# Windows 缺点：Docker Desktop 的 WSL2 里没有 Windows 的 /proc，
# 因此 **不要** 挂载 /proc（挂进来的是 WSL2 虚拟机视图，与任务管理器对不上）。
# 不挂载时门户走 Node 的 os 接口，读到的是 Windows 宿主真实 CPU/内存。
#   - GPU：Docker Desktop 下容器内无法执行 nvidia-smi.exe（Linux 容器跑不了 PE 文件），
#          且 WSL 直通路径 /usr/lib/wsl/lib 在容器内不可见 → GPU 显示"不可用"属预期。
#          需要 GPU 指标时请改用「在 Windows 上原生跑 Node」的部署方式。
#   - 磁盘：把盘挂进容器后由 statfs 读取（写 "C:/" 而不是 "C:"，否则会被当相对路径）。
#           ⚠ compose 里默认**不挂**任何宿主磁盘（Linux/NAS 上没有 C:，默认挂会直接起不来），
#           需要磁盘占用时请先在 docker-compose.yml 的 volumes 里取消注释对应行，再在这里登记。
# PORTAL_DISK_MOUNTS=C:=/host/disk/C
#
# Windows 上 tailnet 查询必须用 API 模式（容器内执行不了 tailscale.exe）：
# PORTAL_TAILSCALE_MODE=api
# PORTAL_TAILSCALE_API_TOKEN=tskey-api-xxxxxxxx

# ============================ NAS（Synology / QNAP / TrueNAS） ============================
# 引擎走 unix socket（与容器化部署的唯一正确写法一致）
# DOCKER_ENDPOINT=unix:///var/run/docker.sock
# DOCKER_SOCKET=/var/run/docker.sock
#
# NAS 上**推荐**再加一层「只读 socket 代理」（Sprint 0 起提供）：
#   docker compose -f docker-compose.yml -f docker-compose.socket-proxy.yml up -d --build
# 它把 docker.sock 藏在代理后面，只放行门户实际用到的 GET 接口，
# 任何写操作（stop/rm/exec/build…）在代理层被拒 —— 比只给 socket 加 :ro 更硬的保证。
# 用法与放行清单见 docker-compose.socket-proxy.yml 顶部注释。
#
# NAS 都是 Linux 宿主，可以直接挂载 /proc 拿到真实占用：
# PORTAL_HOST_PROC=/host/proc
# PORTAL_DISK_MOUNTS=/volume1=/host/volume1,/volume2=/host/volume2
#
# tailnet：推荐的两种方式
#   1) CLI：把宿主 tailscale 挂进容器
#      PORTAL_TAILSCALE_MODE=cli
#      PORTAL_TAILSCALE_BIN=/usr/local/bin/tailscale
#      （compose 中挂载 /usr/bin/tailscale 与 /var/run/tailscale）
#   2) API：完全云端，不需要宿主挂载
#      PORTAL_TAILSCALE_MODE=api
#      PORTAL_TAILSCALE_API_TOKEN=tskey-api-xxxxxxxx
#
# Synology 上 Docker 组 ID 常为 998（旧版 100），遇到 EACCES 时设置：
# DOCKER_GID=998

# ------------------------------------------------------------------ GPU（可选）

# 容器内 nvidia-smi 路径（挂载后由它提供 GPU 占用）
# PORTAL_NVIDIA_SMI=/usr/local/bin/nvidia-smi
# WSL 下 nvidia-smi 依赖的库目录。**注意**：Docker Desktop 的容器内看不到
# /usr/lib/wsl/lib，因此容器化部署在 Windows 上拿不到 GPU 指标；
# 需要 GPU 指标请改用「在 Windows 上原生跑 Node」的方式。
# PORTAL_NVIDIA_LD_LIBRARY_PATH=/usr/lib/wsl/lib

# ------------------------------------------------------------------ 工具目录（可选）

# 自定义工具目录 JSON（挂载进容器后指向该路径）
# PORTAL_TOOLS_FILE=/config/tools.json
# 快速追加工具，格式 id:名称:端口，逗号分隔
# PORTAL_TOOLS_EXTRA=jellyfin:Jellyfin:8096,immich:Immich:2283
# 工具探测结果缓存时长（毫秒），调小则状态更新更快但探测更频繁
# PORTAL_TOOLS_PROBE_TTL_MS=10000
# 强制指定探测目标主机。**一般不需要设置**：
#   留空时先用门户对外主机名探测，失败后自动兜底 host.docker.internal 与 127.0.0.1。
#   容器化部署下宿主服务（Ollama/DSH/ComfyUI 等）通常只能经 host.docker.internal 连上，
#   兜底链已覆盖这种情况。仅在你有特殊网络拓扑时才需要强制指定。
# PORTAL_TOOLS_PROBE_HOST=host.docker.internal

# ------------------------------------------------------------------ 性能与缓存（可选）

# 容器列表缓存（毫秒）。容器多时可调大以减少 docker inspect 次数
# PORTAL_CACHE_CONTAINERS_TTL_MS=2000
# tailnet 状态缓存（毫秒），避免频繁 fork tailscale 进程
# PORTAL_CACHE_TAILSCALE_TTL_MS=5000
# docker stats 超时（毫秒）
# PORTAL_DOCKER_STATS_TIMEOUT_MS=4000
# 外部命令（tailscale / nvidia-smi）超时（毫秒）
# PORTAL_COMMAND_TIMEOUT_MS=5000
