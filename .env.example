# ==============================================================================
# HomePage 门户 — 环境变量样例
#
#   cp .env.example .env      然后按你的平台取消对应注释
#
# 全部变量都有合理默认值，**最小可用配置是空文件**。
# ==============================================================================

# ------------------------------------------------------------------ 门户自身

# 门户对外监听的宿主端口
PORTAL_HOST_PORT=8899

# 端口绑定地址。0.0.0.0 = tailnet 与局域网都可访问；
# 只想经 tailnet 访问时填宿主 tailnet IP（如 100.72.255.29）
PORTAL_BIND_ADDR=0.0.0.0

# 日志级别：debug | info | warn | error
PORTAL_LOG_LEVEL=info

# 门户对外的公开主机名（MagicDNS 名或 tailnet IP），用于生成容器/工具的入口链接。
# 留空时按访问者的请求头自动推导，通常无需设置。
# PORTAL_PUBLIC_HOST=sisi-laptop.tail921448.ts.net

# 部署在 HTTPS 反向代理之后时设为 1（会话 Cookie 会带 Secure 属性）
# PORTAL_SECURE_COOKIES=1

# 首启初始化令牌。留空则自动生成，写入 /data/setup-token.txt 并打印到容器日志。
# 便于自动化部署时可显式指定。
# PORTAL_SETUP_TOKEN=

# 时区（影响日志时间戳与界面时间）
TZ=Asia/Shanghai

# 会话有效期（小时）与「记住我」有效期（小时）
PORTAL_SESSION_TTL_HOURS=12
PORTAL_SESSION_REMEMBER_TTL_HOURS=720

# 指标推送间隔（毫秒）
PORTAL_METRICS_INTERVAL_MS=3000

# ------------------------------------------------------------------ 部署矩阵
#
# 下面按平台给出推荐值。**注意：compose 会读取 .env**，所以直接取消注释即可。

# ============================ Windows 11 + Docker Desktop ============================
# 引擎走 named pipe（Docker Desktop 默认 context 为 desktop-linux）
# DOCKER_ENDPOINT=npipe:////./pipe/dockerDesktopLinuxEngine
# DOCKER_SOCKET=//var/run/docker.sock
#
# Windows 缺点：Docker Desktop 的 WSL2 里没有 Windows 的 /proc，
# 因此 CPU/内存显示的是 WSL 虚拟机视图。可用的真实值：
#   - GPU：经 WSL GPU 直通（需挂载 nvidia-smi，见 README）
#   - 磁盘：把 C:/D: 挂进容器后由 statfs 读取
# PORTAL_HOST_PROC=/host/proc
# PORTAL_DISK_MOUNTS=C:=/host/disk/C,D:=/host/disk/D
#
# Windows 上 tailnet 查询推荐用 CLI 模式（无需 API Token）：
# PORTAL_TAILSCALE_MODE=cli
# PORTAL_TAILSCALE_BIN=/usr/local/bin/tailscale
# （compose 中需挂载：C:\Program Files\Tailscale\tailscale.exe:/usr/local/bin/tailscale:ro）

# ============================ NAS（Synology / QNAP / TrueNAS） ============================
# 引擎走 unix socket
# DOCKER_ENDPOINT=unix:///var/run/docker.sock
# DOCKER_SOCKET=/var/run/docker.sock
#
# NAS 都是 Linux 宿主，可以直接挂载 /proc 拿到真实占用：
# PORTAL_HOST_PROC=/host/proc
# PORTAL_DISK_MOUNTS=/volume1=/host/volume1,/volume2=/host/volume2
#
# tailnet：推荐的两种方式
#   1) CLI：把宿主 tailscale 挂进容器
#      PORTAL_TAILSCALE_MODE=cli
#      PORTAL_TAILSCALE_BIN=/usr/local/bin/tailscale
#      （compose 中挂载 /usr/bin/tailscale 与 /var/run/tailscale）
#   2) API：完全云端，不需要宿主挂载
#      PORTAL_TAILSCALE_MODE=api
#      PORTAL_TAILSCALE_API_TOKEN=tskey-api-xxxxxxxx
#
# Synology 上 Docker 组 ID 常为 998（旧版 100），遇到 EACCES 时设置：
# DOCKER_GID=998

# ------------------------------------------------------------------ GPU（可选）

# 容器内 nvidia-smi 路径（挂载后由它提供 GPU 占用）
# PORTAL_NVIDIA_SMI=/usr/local/bin/nvidia-smi
# WSL 下 nvidia-smi 依赖的库目录（Docker Desktop 通常需要）
# PORTAL_NVIDIA_LD_LIBRARY_PATH=/usr/lib/wsl/lib

# ------------------------------------------------------------------ 工具目录（可选）

# 自定义工具目录 JSON（挂载进容器后指向该路径）
# PORTAL_TOOLS_FILE=/config/tools.json
# 快速追加工具，格式 id:名称:端口，逗号分隔
# PORTAL_TOOLS_EXTRA=jellyfin:Jellyfin:8096,immich:Immich:2283
# 工具探测结果缓存时长（毫秒），调小则状态更新更快但探测更频繁
# PORTAL_TOOLS_PROBE_TTL_MS=10000

# ------------------------------------------------------------------ 性能与缓存（可选）

# 容器列表缓存（毫秒）。容器多时可调大以减少 docker inspect 次数
# PORTAL_CACHE_CONTAINERS_TTL_MS=2000
# tailnet 状态缓存（毫秒），避免频繁 fork tailscale 进程
# PORTAL_CACHE_TAILSCALE_TTL_MS=5000
# docker stats 超时（毫秒）
# PORTAL_DOCKER_STATS_TIMEOUT_MS=4000
# 外部命令（tailscale / nvidia-smi）超时（毫秒）
# PORTAL_COMMAND_TIMEOUT_MS=5000
